{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "resolveJsonModule": true,
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["./*.ts", "installer/**/*.ts", "qa/**/*.ts"],
  "exclude": ["qa/fixtures/**", "qa/omo-native-telemetry-qa.test.ts"]
}
